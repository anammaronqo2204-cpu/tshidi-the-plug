# Postgres connection string. Locally this can point at a Docker/local Postgres.
# On Netlify, set this in Site settings -> Environment variables to a hosted
# Postgres URL (Neon, Supabase, Netlify DB/Neon integration, etc). Netlify's own
# built-in database is also auto-detected under NETLIFY_DATABASE_URL/NETLIFY_DB_URL —
# see src/db/index.ts.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Admin login -------------------------------------------------------------
# See ADMIN-LOGIN-SETUP.md for the full walkthrough. Both are REQUIRED.
#
# The password you log into /admin with. Change this any time in Netlify's
# environment variables and redeploy — no separate account to manage.
ADMIN_PASSWORD=

# Any long random string (e.g. `openssl rand -hex 32`), used only to sign login
# session cookies so they can't be forged. Set it once; don't change it unless
# you think it's leaked (changing it logs everyone out).
ADMIN_SESSION_SECRET=
